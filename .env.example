# ==============================================================================
# Fresher Data Analyst Job Finder - Environment Variables Template
# ==============================================================================
# Copy this file to '.env' and fill in your values:
#   cp .env.example .env
# Never commit your '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Security & Authentication
# ------------------------------------------------------------------------------
# Required API key to authenticate all '/api/*' requests (sent in 'X-API-Key' header).
# The frontend prompt will store this in sessionStorage to authorize client requests.
API_KEY=your_secure_api_key_here

# Required Bearer secret for automated cloud cron trigger at '/api/cron'.
# Vercel Cron and GitHub Actions send this via: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your_cron_secret_token_here

# Comma-separated allowed origins for Cross-Origin Resource Sharing (CORS).
# Wildcard reflection is disabled; only explicitly listed domains are accepted.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. External Scraper Integrations (Apify)
# ------------------------------------------------------------------------------
# Required for running external cloud scrapers on Naukri and Indeed.
# Obtain your API token from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# ------------------------------------------------------------------------------
# 3. LinkedIn Live Recruiter & HR Posts Feed
# ------------------------------------------------------------------------------
# Session cookie ('li_at') for authenticated queries on recruiter & HR hiring posts.
# To ensure security, this cookie is NEVER stored on disk or in settings files.
# Retrieve from: Browser DevTools -> Application -> Cookies -> linkedin.com -> li_at
LI_AT=your_linkedin_li_at_cookie_here

# ------------------------------------------------------------------------------
# 4. Persistent Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# When DATABASE_URL is set, the application uses PostgreSQL (Neon, Supabase, Vercel Postgres, AWS RDS)
# for persistent storage across serverless invocations (tables, jobs, schedules, logs, and files).
# If unset, local SQLite storage (data/jobs.db) is used for local development.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# TEST_DATABASE_URL=postgresql://user:password@host:5432/test_dbname

# ------------------------------------------------------------------------------
# 5. Development Server Configuration
# ------------------------------------------------------------------------------
# Set to 'true' or '1' to enable automatic server reloading on code changes when running start.py
RELOAD=false

# ------------------------------------------------------------------------------
# 6. Cloud Serverless & CI/CD Runtime Flags (Optional)
# ------------------------------------------------------------------------------
# Automatically set by cloud host environments (Vercel, AWS Lambda) or CI runners.
# In local development, leave these commented out or unset.
# VERCEL=1
# AWS_LAMBDA_FUNCTION_NAME=
# DEPLOYED_APP_URL=https://data-aanalyst-job-listing-scrapper-project.vercel.app
